# ============================================================
# LLM Provider Configuration
# ============================================================
# Choose your LLM provider: openai, anthropic, google, bedrock, azure
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini) Configuration
GOOGLE_API_KEY=your_google_api_key_here

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============================================================
# Database Configuration
# ============================================================
# Choose your database type: sqlite, postgresql, mysql, duckdb, snowflake, redshift, bigquery
DATABASE_TYPE=duckdb

# Connection String (for SQLAlchemy-based databases)
# Use TPC-DS test database (created in Step 3 of QUICKSTART.md)
DATABASE_URL=duckdb:///./testing/tpcds_1gb.duckdb
# DATABASE_URL=sqlite:///./data/analytics.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname
# DATABASE_URL=redshift+psycopg2://user:password@cluster.region.redshift.amazonaws.com:5439/dbname

# Snowflake Configuration (alternative to DATABASE_URL)
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_WAREHOUSE=your_warehouse

# BigQuery Configuration
BIGQUERY_PROJECT=your_project_id
BIGQUERY_CREDENTIALS_PATH=path/to/credentials.json

# ============================================================
# Vector Store Configuration
# ============================================================
# Choose: faiss, weaviate, opensearch, kendra, azure_search, vertex_ai, pinecone, chroma
VECTOR_STORE_TYPE=faiss

# Embedding Model Configuration
# Provider: openai, huggingface, cohere, bedrock, vertex_ai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-ada-002
# OpenAI: text-embedding-ada-002, text-embedding-3-small, text-embedding-3-large
# HuggingFace: sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-large-en
# Cohere: embed-english-v3.0, embed-multilingual-v3.0

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# OpenSearch (AWS OpenSearch or self-hosted)
OPENSEARCH_URL=https://your-domain.region.es.amazonaws.com
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password

# AWS Kendra
KENDRA_INDEX_ID=your-kendra-index-id

# Azure Cognitive Search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX_NAME=your-index-name

# Google Vertex AI Vector Search
VERTEX_AI_INDEX_ID=your-index-id
VERTEX_AI_INDEX_ENDPOINT=your-index-endpoint

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=analytics

# Chroma (local or hosted)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Additional API Keys for Embeddings
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# ============================================================
# Agent Configuration
# ============================================================
MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.0
# Model names vary by provider:
# OpenAI: gpt-4.1, gpt-4o, gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Google: gemini-pro, gemini-1.5-pro
# Bedrock: anthropic.claude-v2, anthropic.claude-3-sonnet-20240229-v1:0
AGENT_MODEL=gpt-4.1

# ============================================================
# Data Cache Configuration (NEW)
# ============================================================
# Enable/disable data caching for multi-turn conversations
ENABLE_DATA_CACHE=true

# Maximum rows to cache (prevents memory issues with large tables)
MAX_CACHE_ROWS=10000

# Maximum cache size in MB (prevents OOM errors)
MAX_CACHE_SIZE_MB=100

# Cache TTL in seconds (auto-expires stale data)
# Set to 0 for no expiration
CACHE_TTL_SECONDS=3600

# Auto-sample large results? If true, large datasets are randomly sampled
# WARNING: Analysis will run on SAMPLE, not full data!
# RECOMMENDED: false (reject large data instead of sampling)
AUTO_SAMPLE_LARGE_RESULTS=false

# Sample size when auto-sampling large results
SAMPLE_SIZE=1000

# ============================================================
# Streamlit Configuration
# ============================================================
STREAMLIT_PORT=8501
