# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Settings
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0

# Vector Store Settings
VECTOR_STORE_TYPE=faiss  # Options: faiss, weaviate
WEAVIATE_URL=http://localhost:8080

# Database Settings
DATABASE_PATH=data/examples/sample.db

# Agent Settings
MAX_ITERATIONS=10
VERBOSE=true
